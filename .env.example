# Application Port
PORT=3000

# PostgreSQL Credentials
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_password_here
POSTGRES_DB=tasks

# Connection Strings
# Local Development (Host machine outside Docker):
DATABASE_URL=postgres://postgres:your_password_here@localhost:5432/tasks
REDIS_URL=redis://localhost:6379

# Note: Inside Docker Compose, DATABASE_URL and REDIS_URL are automatically
# constructed using container service names (e.g., db:5432, redis:6379).

# Supabase
SUPABASE_URL=your_supabase_project_url
SUPABASE_KEY=your_supabase_anon_key

# Comma-separated Supabase user IDs authorized as admins
ADMIN_USER_IDS=
{
  "openapi": "3.0.3",
  "info": {
    "title": "Task API",
    "description": "A RESTful CRUD API for managing tasks built using Express.js. Includes filtering, search, sorting, pagination, task statistics, and reset functionality.",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "http://localhost:3000",
      "description": "Local Development Server"
    }
  ],
  "tags": [
    {
      "name": "General",
      "description": "General API endpoints"
    },
    {
      "name": "Tasks",
      "description": "CRUD operations on tasks"
    },
    {
      "name": "Extras",
      "description": "Filtering, search, sorting, pagination, statistics, and reset functionality"
    },
    {
      "name": "Authentication",
      "description": "Signup, login, and logout using Supabase Auth"
    },
    {
      "name": "Public",
      "description": "Endpoints that do not require authentication"
    },
    {
      "name": "Protected",
      "description": "Endpoints requiring a valid Supabase access token"
    }
  ],
  "paths": {
    "/": {
      "get": {
        "tags": ["General"],
        "summary": "API Information",
        "description": "Returns basic information about the Task API and its main endpoints.",
        "responses": {
          "200": {
            "description": "API information returned successfully",
            "content": {
              "application/json": {
                "example": {
                  "name": "Task API",
                  "version": "1.0",
                  "endpoints": ["/tasks", "/stats", "/reset", "/docs"]
                }
              }
            }
          }
        }
      }
    },
    "/health": {
      "get": {
        "tags": ["General"],
        "summary": "Health Check",
        "description": "Checks whether the API server is running.",
        "responses": {
          "200": {
            "description": "Server is running successfully",
            "content": {
              "application/json": {
                "example": {
                  "status": "ok"
                }
              }
            }
          }
        }
      }
    },
    "/tasks": {
      "get": {
        "tags": ["Tasks"],
        "summary": "Retrieve tasks",
        "description": "Returns all tasks. Results can optionally be filtered, searched, sorted, and paginated using query parameters.",
        "parameters": [
          {
            "name": "done",
            "in": "query",
            "required": false,
            "description": "Filter tasks by completion status.",
            "schema": {
              "type": "boolean"
            },
            "examples": {
              "completed": {
                "summary": "Completed tasks",
                "value": true
              },
              "open": {
                "summary": "Open tasks",
                "value": false
              }
            }
          },
          {
            "name": "search",
            "in": "query",
            "required": false,
            "description": "Search for tasks whose title contains the provided text. Search is case-insensitive.",
            "schema": {
              "type": "string"
            },
            "example": "book"
          },
          {
            "name": "sort",
            "in": "query",
            "required": false,
            "description": "Sort tasks by title.",
            "schema": {
              "type": "string",
              "enum": ["title"]
            },
            "example": "title"
          },
          {
            "name": "order",
            "in": "query",
            "required": false,
            "description": "Sort order when sorting by title.",
            "schema": {
              "type": "string",
              "enum": ["asc", "desc"],
              "default": "asc"
            },
            "example": "asc"
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "description": "Maximum number of tasks to return.",
            "schema": {
              "type": "integer",
              "minimum": 0
            },
            "example": 2
          },
          {
            "name": "offset",
            "in": "query",
            "required": false,
            "description": "Number of tasks to skip before returning results.",
            "schema": {
              "type": "integer",
              "minimum": 0,
              "default": 0
            },
            "example": 0
          }
        ],
        "responses": {
          "200": {
            "description": "Tasks retrieved successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Task"
                  }
                },
                "example": [
                  {
                    "id": 1,
                    "title": "Buy groceries",
                    "done": false,
                    "created_at": "2026-09-04 03:00:00",
                    "updated_at": "2026-09-04 03:00:00"
                  },
                  {
                    "id": 2,
                    "title": "Walk the dog",
                    "done": true,
                    "created_at": "2026-09-04 03:00:00",
                    "updated_at": "2026-09-04 03:00:00"
                  }
                ]
              }
            }
          }
        }
      },
      "post": {
        "tags": ["Tasks"],
        "summary": "Create a new task",
        "description": "Creates a new task. The title is required and the new task is created with done set to false.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateTask"
              },
              "example": {
                "title": "Learn Express"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Task created successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Task"
                },
                "example": {
                  "id": 4,
                  "title": "Learn Express",
                  "done": false,
                  "created_at": "2026-09-04 03:00:00",
                  "updated_at": "2026-09-04 03:00:00"
                }
              }
            }
          },
          "400": {
            "description": "Invalid task title",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": "Title is required"
                }
              }
            }
          }
        }
      }
    },
    "/tasks/{id}": {
      "get": {
        "tags": ["Tasks"],
        "summary": "Get task by ID",
        "description": "Returns a single task using its numeric ID.",
        "parameters": [
          {
            "$ref": "#/components/parameters/TaskId"
          }
        ],
        "responses": {
          "200": {
            "description": "Task found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Task"
                },
                "example": {
                  "id": 1,
                  "title": "Buy groceries",
                  "done": false,
                  "created_at": "2026-09-04 03:00:00",
                  "updated_at": "2026-09-04 03:00:00"
                }
              }
            }
          },
          "404": {
            "description": "Task not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": "Task not found"
                }
              }
            }
          }
        }
      },
      "put": {
        "tags": ["Tasks"],
        "summary": "Update a task",
        "description": "Updates the title, completion status, or both for an existing task.",
        "parameters": [
          {
            "$ref": "#/components/parameters/TaskId"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateTask"
              },
              "examples": {
                "updateBoth": {
                  "summary": "Update title and status",
                  "value": {
                    "title": "Finish Assignment",
                    "done": true
                  }
                },
                "updateDone": {
                  "summary": "Update completion status only",
                  "value": {
                    "done": true
                  }
                },
                "updateTitle": {
                  "summary": "Update title only",
                  "value": {
                    "title": "Complete assignment today"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Task updated successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Task"
                },
                "example": {
                  "id": 1,
                  "title": "Finish Assignment",
                  "done": true,
                  "created_at": "2026-09-04 03:00:00",
                  "updated_at": "2026-09-04 03:15:00"
                }
              }
            }
          },
          "400": {
            "description": "Invalid update data",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "examples": {
                  "nothingToUpdate": {
                    "value": {
                      "error": "Nothing to update"
                    }
                  },
                  "invalidTitle": {
                    "value": {
                      "error": "Invalid title"
                    }
                  },
                  "invalidDone": {
                    "value": {
                      "error": "Done must be true or false"
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "Task not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": "Task not found"
                }
              }
            }
          }
        }
      },
      "delete": {
        "tags": ["Tasks"],
        "summary": "Delete a task",
        "description": "Deletes a task using its numeric ID.",
        "parameters": [
          {
            "$ref": "#/components/parameters/TaskId"
          }
        ],
        "responses": {
          "204": {
            "description": "Task deleted successfully"
          },
          "404": {
            "description": "Task not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": "Task not found"
                }
              }
            }
          }
        }
      }
    },
    "/stats": {
      "get": {
        "tags": ["Extras"],
        "summary": "Get task statistics",
        "description": "Returns the total number of tasks together with the number of completed and open tasks.",
        "responses": {
          "200": {
            "description": "Task statistics retrieved successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Stats"
                },
                "example": {
                  "total": 3,
                  "done": 1,
                  "open": 2
                }
              }
            }
          }
        }
      }
    },
    "/reset": {
      "post": {
        "tags": ["Extras"],
        "summary": "Reset tasks",
        "description": "Removes the current tasks from SQLite and restores the default three tasks.",
        "responses": {
          "200": {
            "description": "Tasks reset successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Task"
                  }
                },
                "example": [
                  {
                    "id": 1,
                    "title": "Buy groceries",
                    "done": false,
                    "created_at": "2026-09-04 03:00:00",
                    "updated_at": "2026-09-04 03:00:00"
                  },
                  {
                    "id": 2,
                    "title": "Walk the dog",
                    "done": true,
                    "created_at": "2026-09-04 03:00:00",
                    "updated_at": "2026-09-04 03:00:00"
                  },
                  {
                    "id": 3,
                    "title": "Read a book",
                    "done": false,
                    "created_at": "2026-09-04 03:00:00",
                    "updated_at": "2026-09-04 03:00:00"
                  }
                ]
              }
            }
          }
        }
      }
    },
    "/auth/signup": {
      "post": {
        "tags": ["Authentication"],
        "summary": "Create an account",
        "description": "Registers a user through Supabase Auth. Passwords are handled by Supabase and are not stored by this API.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AuthCredentials"
              },
              "example": {
                "email": "test@example.com",
                "password": "Test12345!"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Signup successful",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string",
                      "example": "Signup successful"
                    },
                    "user": {
                      "type": "object",
                      "description": "Supabase user object"
                    }
                  }
                },
                "example": {
                  "message": "Signup successful",
                  "user": {
                    "id": "user-id",
                    "email": "test@example.com"
                  }
                }
              }
            }
          },
          "400": {
            "description": "Missing input or Supabase signup error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": "Email and password are required"
                }
              }
            }
          }
        }
      }
    },
    "/auth/login": {
      "post": {
        "tags": ["Authentication"],
        "summary": "Log in",
        "description": "Authenticates credentials with Supabase Auth and returns access and refresh tokens.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AuthCredentials"
              },
              "example": {
                "email": "test@example.com",
                "password": "Test12345!"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Login successful",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "message",
                    "access_token",
                    "refresh_token",
                    "user"
                  ],
                  "properties": {
                    "message": {
                      "type": "string",
                      "example": "Login successful"
                    },
                    "access_token": {
                      "type": "string"
                    },
                    "refresh_token": {
                      "type": "string"
                    },
                    "user": {
                      "type": "object",
                      "description": "Supabase user object"
                    }
                  }
                },
                "example": {
                  "message": "Login successful",
                  "access_token": "eyJ...",
                  "refresh_token": "eyJ...",
                  "user": {
                    "id": "user-id",
                    "email": "test@example.com"
                  }
                }
              }
            }
          },
          "400": {
            "description": "Email or password missing",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": "Email and password are required"
                }
              }
            }
          },
          "401": {
            "description": "Invalid credentials or login failure",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": "Invalid login credentials"
                }
              }
            }
          }
        }
      }
    },
    "/auth/logout": {
      "post": {
        "tags": ["Authentication"],
        "summary": "Log out",
        "description": "Signs out the authenticated Supabase session using the supplied access token.",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "responses": {
          "204": {
            "description": "Logout successful; no response body"
          },
          "401": {
            "description": "Missing, malformed, invalid, or expired access token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": "Invalid or expired token"
                }
              }
            }
          },
          "500": {
            "description": "Logout failed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": "Logout failed"
                }
              }
            }
          }
        }
      }
    },
    "/public/info": {
      "get": {
        "tags": ["Public"],
        "summary": "Get public information",
        "description": "Returns public information without requiring a bearer token.",
        "responses": {
          "200": {
            "description": "Public information returned successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string"
                    },
                    "authenticated": {
                      "type": "boolean"
                    }
                  }
                },
                "example": {
                  "message": "This is public information",
                  "authenticated": false
                }
              }
            }
          }
        }
      }
    },
    "/protected/profile": {
      "get": {
        "tags": ["Protected"],
        "summary": "Get authenticated user profile",
        "description": "Validates the Supabase access token and returns selected user information.",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Authenticated user profile returned",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string"
                    },
                    "user": {
                      "type": "object",
                      "properties": {
                        "id": {
                          "type": "string"
                        },
                        "email": {
                          "type": "string",
                          "format": "email"
                        },
                        "created_at": {
                          "type": "string",
                          "format": "date-time"
                        }
                      }
                    }
                  }
                },
                "example": {
                  "message": "Authenticated successfully",
                  "user": {
                    "id": "user-id",
                    "email": "test@example.com",
                    "created_at": "2026-10-15T21:26:11.933967Z"
                  }
                }
              }
            }
          },
          "401": {
            "description": "Missing, malformed, invalid, or expired token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": "Invalid or expired token"
                }
              }
            }
          }
        }
      }
    },
    "/protected/dashboard": {
      "get": {
        "tags": ["Protected"],
        "summary": "Access protected dashboard",
        "description": "Returns a simple dashboard response for an authenticated user.",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Dashboard response returned",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string"
                    },
                    "user_id": {
                      "type": "string"
                    }
                  }
                },
                "example": {
                  "message": "Welcome to your protected dashboard",
                  "user_id": "user-id"
                }
              }
            }
          },
          "401": {
            "description": "Missing, malformed, invalid, or expired token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": "Missing or malformed authorization token"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "parameters": {
      "TaskId": {
        "name": "id",
        "in": "path",
        "required": true,
        "description": "Numeric ID of the task.",
        "schema": {
          "type": "integer",
          "minimum": 1
        },
        "example": 1
      }
    },
    "schemas": {
      "Task": {
        "type": "object",
        "required": ["id", "title", "done", "created_at", "updated_at"],
        "properties": {
          "id": {
            "type": "integer",
            "minimum": 1,
            "example": 1
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "example": "Buy groceries"
          },
          "done": {
            "type": "boolean",
            "example": false
          },
          "created_at": {
            "type": "string",
            "description": "Timestamp when the task was created.",
            "example": "2026-09-04 03:00:00"
          },
          "updated_at": {
            "type": "string",
            "description": "Timestamp when the task was last updated.",
            "example": "2026-09-04 03:00:00"
          }
        }
      },
      "CreateTask": {
        "type": "object",
        "required": ["title"],
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1,
            "description": "Title of the new task.",
            "example": "Build CRUD API"
          }
        }
      },
      "UpdateTask": {
        "type": "object",
        "description": "At least one of title or done must be provided.",
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1,
            "example": "Complete Assignment"
          },
          "done": {
            "type": "boolean",
            "example": true
          }
        }
      },
      "Stats": {
        "type": "object",
        "required": ["total", "done", "open"],
        "properties": {
          "total": {
            "type": "integer",
            "minimum": 0,
            "description": "Total number of tasks.",
            "example": 3
          },
          "done": {
            "type": "integer",
            "minimum": 0,
            "description": "Number of completed tasks.",
            "example": 1
          },
          "open": {
            "type": "integer",
            "minimum": 0,
            "description": "Number of incomplete tasks.",
            "example": 2
          }
        }
      },
      "Error": {
        "type": "object",
        "required": ["error"],
        "properties": {
          "error": {
            "type": "string",
            "example": "Task not found"
          }
        }
      },
      "AuthCredentials": {
        "type": "object",
        "required": ["email", "password"],
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "example": "test@example.com"
          },
          "password": {
            "type": "string",
            "format": "password",
            "minLength": 1,
            "example": "Test12345!"
          }
        }
      }
    },
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "Enter your Supabase access token. Swagger UI adds the Bearer prefix automatically."
      }
    }
  }
}
